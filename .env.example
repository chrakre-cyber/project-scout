# Project Scout — eksempel på miljøvariabler. Kopier til .env.local (gitignorert).
# Ikke legg ekte nøkler, passord eller service-role/secret-nøkler i git.

# Supabase (DEV-002). Bare URL og publishable key brukes av appen.
# Uten disse kjører appen i demomodus uten innlogging.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Kun for demo/kontroll: simulerer en kildefeil i den syntetiske provideren uten nettverk.
# Gyldige verdier: authentication, forbidden, rate_limit, invalid_query, timeout, unavailable, malformed_data
# SCOUT_SYNTHETIC_FAILURE=
