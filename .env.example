# Project Scout — eksempel på miljøvariabler. Kopier til .env.local (gitignorert).
# Ikke legg ekte nøkler, passord eller service-role/secret-nøkler i git.

# Supabase (DEV-002). Bare URL og publishable key brukes av appen.
# Uten disse kjører appen i demomodus uten innlogging.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Kun for demo/kontroll: simulerer en kildefeil i den syntetiske provideren uten nettverk.
# Gyldige verdier: authentication, forbidden, rate_limit, invalid_query, timeout, unavailable, malformed_data
# SCOUT_SYNTHETIC_FAILURE=

# Betrodd skrivevei for søkeresultater (DEV-005B0, DEC-029). KUN serverside; aldri NEXT_PUBLIC_.
# Tilkobling som den begrensede databaserollen `scout_ingest` (ikke service-role). Uten den kan ikke søkekjøringer startes.
# Lokalt: `npm run setup:ingest-role` skriver verdien til .env.local. Hosted: se README.
SCOUT_INGEST_DATABASE_URL=

# Eldre Project Scout-ruter (/dashboard, /agents/**, /opportunities/**) er BLOKKERT som standard (omdirigeres til /login) slik at de ikke
# kan nås av eksterne partnere i Merovo-demoen. Intern utvikling kan åpne dem ved å sette verdien til nøyaktig 1.
# Leses ved BYGGING (next build / next dev-oppstart); tom, manglende eller annen verdi betyr blokkert. Aldri sett denne for en partnerdemo.
# SCOUT_ENABLE_LEGACY_ROUTES=1

# Nøkkel for opake annonse-id-er i resultat-URL-er (DATA-002C). Server-only (aldri NEXT_PUBLIC_), minst 16 tegn, aldri i git/logg/chat.
# Valgfri for den syntetiske demoen (en innebygd, IKKE-hemmelig pepper brukes). PÅKREVD før sandbox-/produksjonskilder: uten nøkkel feiler id-generering lukket.
# SCOUT_PUBLIC_ID_KEY=
